{"nodes": [{"id": "docs_multi_issuer", "label": "Multi-Issuer OIDC Authentication guide", "file_type": "document", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_multi_issuer_authentication_configuration", "label": "Structured AuthenticationConfiguration (apiserver.config.k8s.io v1/v1beta1)", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the same file format kube-apiserver consumes since 1.30; useful on managed clusters where apiserver flags cannot change. Strictly validated at startup (unknown fields, duplicate issuers, invalid CEL rejected); only jwt: is supported, anonymous: rejected; read once at startup."}, {"id": "docs_multi_issuer_cel_claim_mappings", "label": "CEL claim mappings (username/groups expressions)", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groups expressions may return a list so one token can carry groups along several axes; prefixes must live inside expressions since prefix: only applies to claim:. Every referenced claim must be present or authentication fails; guard optional claims with has()."}, {"id": "docs_multi_issuer_claim_validation_rules", "label": "claimValidationRules", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin org/owner IDs so a recycled name cannot inherit access; with expression-based usernames email_verified is not auto-enforced and must be checked explicitly."}, {"id": "docs_multi_issuer_github_actions_recipe", "label": "GitHub Actions issuer recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub tokens carry no groups claim so CEL synthesizes one from repository_owner; newer sub embeds numeric IDs so decode a real token or use a CEL username."}, {"id": "docs_multi_issuer_teamcity_recipe", "label": "TeamCity (teamcity-oidc-jwt) issuer recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw sub is an internal ID chain; external-ID claims (build_type_external_id, project_external_id) make better identities."}, {"id": "docs_multi_issuer_google_service_accounts_recipe", "label": "Google service account issuer recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_multi_issuer_gke_cluster_issuer_recipe", "label": "GKE cluster ServiceAccount issuer recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trusting the cluster's own issuer makes every ServiceAccount bindable without Google service accounts; one entry and prefix per source cluster makes system:serviceaccount subs collision-proof."}, {"id": "docs_multi_issuer_internal_issuer_recipe", "label": "Internal issuer with private CA recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Systems you control should emit a real groups array so no CEL is needed and onboarding is a change in the issuing system, not cluster RBAC."}, {"id": "docs_multi_issuer_gitlab_ci_recipe", "label": "GitLab CI issuer recipe", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_multi_issuer_distinct_prefixes", "label": "Distinct per-issuer prefixes", "file_type": "rationale", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All issuers feed the same RBAC namespace; without distinct prefixes issuer B could mint a sub or group colliding with an identity bound for issuer A. Never use unprefixed usernames in a multi-issuer setup."}, {"id": "docs_multi_issuer_config_checksum_restart", "label": "Helm config checksum rolling restart", "file_type": "concept", "source_file": "docs/multi-issuer.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The config file is read once at startup, so the chart annotates the Deployment with a config checksum to trigger a rolling restart on change."}], "edges": [{"source": "docs_multi_issuer", "target": "docs_multi_issuer_authentication_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/multi-issuer.md", "source_location": null, "weight": 1.0}, {"source": "docs_multi_issuer_authentication_configuration", "target": "docs_configuration_authentication_config_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/multi-issuer.md", "source_location": null, "weight": 1.0}, {"source": "docs_multi_issuer_authentication_configuration", "target": "docs_multi_issuer_cel_claim_mappings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/multi-issuer.md", "source_location": null, "weight": 1.0}, {"source": "docs_multi_issuer_authentication_configuration", "target": "docs_multi_issuer_claim_validation_rules", "relation": "references", "confidence": "EXTRACTED", "conf