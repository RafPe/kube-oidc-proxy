{"nodes": [{"id": "docs_configuration", "label": "Configuration reference", "file_type": "document", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags are defined in cmd/app/options/; --oidc-* flags mirror the kube-apiserver OIDC authenticator so single-issuer config carries over one-to-one."}, {"id": "docs_configuration_authentication_config_flag", "label": "--authentication-config flag", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configuration_single_issuer_oidc_flags", "label": "Single-issuer --oidc-* flags", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configuration_oidc_tls_client_flags", "label": "OIDC issuer mutual TLS client cert/key flags", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apply to every issuer in both modes; file-backed credentials are re-read by client-go so rotation via the projected Secret (oidc.tlsClient.existingSecret) needs no pod restart."}, {"id": "docs_configuration_token_passthrough", "label": "Token passthrough (--token-passthrough)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alpha: tokens failing OIDC validation are tried via TokenReview and, if valid, forwarded as-is with no impersonation; --token-passthrough-audiences overrides the audience set."}, {"id": "docs_configuration_impersonation_model", "label": "Impersonation model", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxy authenticates as its own ServiceAccount and attaches Impersonate-* headers; impersonation replaces but does not bypass RBAC."}, {"id": "docs_configuration_inbound_impersonation", "label": "Inbound impersonation (kubectl --as)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbound Impersonate-* headers are honoured only after a SubjectAccessReview confirms the authenticated user may assume that identity."}, {"id": "docs_configuration_subject_access_review_timeout", "label": "--subject-access-review-timeout shared budget", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single shared budget across all SAR calls for one request, not per-call; must be greater than 0."}, {"id": "docs_configuration_reserved_system_identities", "label": "Reserved system: identity refusal", "file_type": "rationale", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kubernetes does not guard system: on claim mappings and the chart grants impersonate without resourceNames, so by default the proxy refuses (403) any system:-prefixed username and any system: group other than system:authenticated. The check runs in the authentication handler before the SAR so a forged group cannot feed the authorization decision; identity is refused rather than silently stripped. Defense in depth: prefixes remain the primary control. SAR-authorized Impersonate-* targets are left alone to preserve break-glass."}, {"id": "docs_configuration_allow_reserved_groups", "label": "--allow-reserved-groups", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only listed system: groups are permitted; there is no way to permit a reserved username because system:serviceaccount:<ns>:<name> is the most direct path to another identity's privileges. Entries must start with system: or startup is refused, since an unreserved entry is almost certainly a typo."}, {"id": "docs_configuration_original_user_audit_headers", "label": "originaluser.jetstack.io-* audit extra headers", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime API contract left unchanged from upstream so the API server audit log records who really made the request; extras are subresources requiring explicit impersonate RBAC."}, {"id": "docs_configuration_disable_impersonation", "label": "--disable-impersonation", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configuration_extra_user_headers", "label": "Extra impersonation headers (--extra-user-headers, --extra-user-header-client-ip)", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_configuration_trusted_proxies", "label": "Trusted proxies and client IP resolution (--trusted-proxies)", "file_type": "rationale", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default trusts nothing: X-Forwarded-For is client-supplied and honouring it unconditionally would let any direct client forge its IP, poisoning audit logs and the Remote-Client-IP extra. XFF is walked only when the direct peer is inside a trusted CIDR; RFC 7239 Forwarded is not parsed."}, {"id": "docs_configuration_auditing", "label": "Kubernetes-style auditing options", "file_type": "concept", "source_file": "docs/configuration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same auditing options as kube-apiserver except --audit-dynamic-configuration is not supported."}], "edges": [{"source": "docs_configuration", "target": "docs_configuration_authentication_config_flag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_configuration_single_issuer_oidc_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_configuration_oidc_tls_client_flags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_configuration_token_passthrough", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_configuration_impersonation_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_configuration_trusted_proxies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/configuration.md", "source_location": null, "weight": 1.0}, {"source": "docs_configuration", "target": "docs_config