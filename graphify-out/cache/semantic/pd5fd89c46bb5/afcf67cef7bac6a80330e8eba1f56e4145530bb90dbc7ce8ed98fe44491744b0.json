{"nodes": [{"id": "docs_releases", "label": "Releases doc", "file_type": "document", "source_file": "docs/releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary PRs never publish a release; review-gated contract shared with other RafPe Go projects."}, {"id": "docs_releases_release_labels", "label": "release/major|minor|patch|skip PR labels", "file_type": "concept", "source_file": "docs/releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest label since the previous release wins (major > minor > patch); only-skip changes produce no release."}, {"id": "docs_releases_changelog_fragments", "label": ".changes/unreleased/*.yaml changelog fragments", "file_type": "concept", "source_file": "docs/releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_releases_prepare_release_workflow", "label": "Prepare Release workflow (release/next -> main)", "file_type": "concept", "source_file": "docs/releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual, serialized; computes next version, batches fragments, opens release PR with autorelease: pending. Refuses to run without that label because such a PR could never be published; requires Actions permission to open PRs."}, {"id": "docs_releases_release_workflow", "label": "Release workflow (tag, publish image/chart, GitHub Release)", "file_type": "concept", "source_file": "docs/releases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging the release PR is the human publication approval; verification (make verify test, all E2E shards) runs against the exact merge commit before a tag exists; then annotated immutable tag, signed image and chart