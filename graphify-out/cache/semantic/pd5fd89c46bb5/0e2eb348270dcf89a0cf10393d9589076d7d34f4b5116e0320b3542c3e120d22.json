{"nodes": [{"id": "_github_workflows_build", "label": "build workflow", "file_type": "document", "source_file": ".github/workflows/build.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishes a mutable development image (:edge and :main-<sha>) to GHCR on every push to main so unreleased changes can be tested. Versioned immutable images are release-image.yaml's job. Concurrency never cancels in progress so a pushed :edge image is always fully signed with its SBOM."}, {"id": "_github_workflows_build_image", "label": "build:image job", "file_type": "code", "source_file": ".github/workflows/build.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_workflows_build_keyless_image_signing", "label": "Cosign Keyless Signing and SBOM Attachment", "file_type": "rationale", "source_file": ".github/workflows/build.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Images are signed by digest with cosign keyless (id-token: write) and an SPDX SBOM from anchore/sbom-action is attached; SBOM steps are continue-on-error so a supply-chain metadata failure never blocks the image publish. Same pattern reused for dev (:edge) and release images and for the OCI Helm chart."}, {"id": "hack_version_ldflags", "label": "hack/version-ldflags.sh", "file_type": "code", "source_file": ".github/workflows/build.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_build", "target": "_github_workflows_build_image", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/build.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_build_image", "target": "hack_version_ldflags", "relation": "calls", "confi