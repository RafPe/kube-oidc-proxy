{"nodes": [{"id": "chart_kube_oidc_proxy_readme_helm_chart", "label": "kube-oidc-proxy Helm chart README", "file_type": "document", "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L1-L322", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "chart_kube_oidc_proxy_readme_mutually_exclusive_auth_modes", "label": "Mutually exclusive single-issuer / multi-issuer chart modes", "file_type": "rationale", "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L7-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When authenticationConfig.content is non-empty the chart passes --authentication-config and omits issuer-specific --oidc-* flags; oidc.tlsClient stays available in either mode because its mTLS credentials apply to every issuer."}, {"id": "chart_kube_oidc_proxy_readme_hardened_security_context", "label": "Hardened SecurityContext by default", "file_type": "rationale", "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L294-L305", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The proxy is a privileged component whose ServiceAccount can impersonate identities, so it runs non-root (uid 1000), read-only rootfs, all capabilities dropped, no privilege escalation, RuntimeDefault seccomp; relax readOnlyRootFilesystem only for local writes such as audit-log-path."}, {"id": "chart_kube_oidc_proxy_readme_high_availability", "label": "High-availability guidance (PDB + topology spread)", "file_type": "concept", "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L268-L292", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ships single-replica; for production run 3 replicas with a PodDisruptionBudget and topologySpreadConstraints (preferred over anti-affinity), and keep readinessRequireAllIssuers false so one IdP outage cannot block a rollout."}], "edges": [{"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_readme_mutually_exclusive_auth_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L7-L17", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_readme_hardened_security_context", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L294-L305", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_readme_high_availability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L268-L292", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_values_values", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L57", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_ci_single_issuer_values_single_issuer_fixture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L313", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_helm_chart", "target": "chart_kube_oidc_proxy_ci_multi_issuer_values_multi_issuer_fixture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "chart/kube-oidc-proxy/README.md", "source_location": "L314", "weight": 1.0}, {"source": "chart_kube_oidc_proxy_readme_mutually_exclusive_auth_modes", "target": "chart_kube_oidc_proxy_templates_deployment_args_mode_switch", "relation": "rationale_for", "confidence": "INFERRED", "confidence