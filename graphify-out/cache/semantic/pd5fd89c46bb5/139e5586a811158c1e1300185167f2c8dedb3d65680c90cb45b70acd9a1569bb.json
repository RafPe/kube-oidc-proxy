{"nodes": [{"id": "readme_kube_oidc_proxy", "label": "kube-oidc-proxy (project overview)", "file_type": "document", "source_file": "README.md", "source_location": "L12-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managed clusters (EKS, GKE, AKS) do not expose the API server's --oidc-* flags, so a reverse proxy validates the bearer token and impersonates the user; existing RBAC stays authoritative."}, {"id": "readme_multi_issuer_authentication", "label": "Multi-issuer OIDC authentication", "file_type": "concept", "source_file": "README.md", "source_location": "L54-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Headline fork feature: one proxy accepts tokens from several issuers via a Kubernetes AuthenticationConfiguration, each with its own audiences and claim prefixes, so a single deployment serves multiple identity providers."}, {"id": "readme_authenticationconfiguration", "label": "Kubernetes AuthenticationConfiguration (apiserver.config.k8s.io)", "file_type": "concept", "source_file": "README.md", "source_location": "L56-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_impersonation_not_credential_sharing", "label": "Impersonation instead of credential sharing", "file_type": "rationale", "source_file": "README.md", "source_location": "L81-L93", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The proxy forwards requests with its own ServiceAccount plus Impersonate-* headers so the API server evaluates RBAC for the mapped user; kubectl --as is gated by SubjectAccessReview so blanket impersonation rights are never handed to clients."}, {"id": "readme_union_authenticator", "label": "Union authenticator", "file_type": "concept", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_subjectaccessreview", "label": "SubjectAccessReview (impersonation authorization)", "file_type": "concept", "source_file": "README.md", "source_location": "L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tokenreview", "label": "TokenReview (passthrough token validation)", "file_type": "concept", "source_file": "README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_token_passthrough", "label": "Token passthrough", "file_type": "concept", "source_file": "README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-OIDC bearer tokens (e.g. service-account tokens) are still usable through the proxy by validating them against the API server via TokenReview instead of rejecting them."}, {"id": "readme_configurable_readiness", "label": "Configurable readiness (first issuer vs all issuers)", "file_type": "concept", "source_file": "README.md", "source_location": "L94", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_release_process", "label": "Label-driven, review-gated release process", "file_type": "concept", "source_file": "README.md", "source_location": "L113-L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordinary merges never publish. Every PR carries exactly one release/* label and a changelog fragment; a maintainer runs Prepare Release, reviews the automation-owned release/next PR, and its merge triggers verification, sharded Kind E2E, an immutable tag, signed multi-arch images and the OCI chart."}, {"id": "readme_fork_lineage", "label": "Fork lineage: jetstack -> TremoloSecurity -> rafpe", "file_type": "concept", "source_file": "README.md", "source_location": "L123-L126", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source"