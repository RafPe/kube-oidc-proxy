{"nodes": [{"id": "docs_architecture", "label": "Architecture doc", "file_type": "document", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_request_flow", "label": "Request flow (kubectl -> proxy -> JWKS -> apiserver -> RBAC)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxy performs authentication itself so OIDC login works without touching the API server's --oidc-* flags, which are unreachable on managed control planes (EKS, GKE, AKS)."}, {"id": "docs_architecture_handler_chain", "label": "Auth -> impersonate -> audit -> proxy handler chain", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every request passes the same pipeline: authenticate (with TokenReview fallback), resolve impersonation target (SubjectAccessReview, header cap 431), impersonate as own ServiceAccount recording originaluser.jetstack.io-* extras, then stream to API server. Each stage maps to a handler in pkg/proxy."}, {"id": "docs_architecture_union_authenticator", "label": "Multi-issuer union authenticator", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One authenticator per issuer combined into a union; a token is offered to each in turn and the first that accepts wins. Lets one proxy accept a corporate IdP and GitHub Actions OIDC simultaneously; per-issuer prefixes keep identities from colliding."}, {"id": "docs_architecture_readiness_semantics", "label": "--readiness-require-all-issuers readiness semantics", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default false: pod Ready once at least one issuer has fetched JWKS so a single IdP outage cannot block a rollout for every other system; pending issuers keep initializing in the background. true: Ready only when every issuer initialized. Configuration errors always fail startup."}, {"id": "docs_architecture_impersonation", "label": "Kubernetes impersonation headers (Impersonate-User/Group/Extra)", "file_type": "concept", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_mode_exclusivity", "label": "Single-issuer vs multi-issuer mode mutual exclusivity", "file_type": "rationale", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When --authentication-config is set, issuer-specific --oidc-* flags are rejected; the OIDC TLS client cert/key pair is transport config shared by all issuers and therefore accepted in either mode."}, {"id": "docs_architecture_c4_diagrams", "label": "C4 diagrams (c4/workspace.dsl, Structurizr)", "file_type": "document", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagrams are generated from Structurizr DSL; edit the model and re-render rather than editing images by hand."}], "edges": [{"source": "docs_architecture", "target": "docs_architecture_request_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture", "target": "docs_architecture_handler_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture.