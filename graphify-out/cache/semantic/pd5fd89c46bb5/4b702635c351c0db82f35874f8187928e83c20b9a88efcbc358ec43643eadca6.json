{"nodes": [{"id": "demo_readme", "label": "Multi-issuer demo README", "file_type": "document", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "demo_readme_multi_issuer_demo", "label": "Multi-issuer demo flow (two Dex issuers, one proxy)", "file_type": "concept", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves the headline feature locally: a single proxy trusting two independent OIDC issuers, with tokens from either impersonated as distinct users (oidc-a:alice, oidc-b:bob). Runs in kind with no cloud accounts, DNS, or browser."}, {"id": "demo_readme_dex_issuers", "label": "Dex issuers dex-a / dex-b", "file_type": "concept", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Dex issuer: value is set to exactly its Service DNS URL so the discovery document's iss matches what the proxy dials; serving cert SANs cover the in-cluster Service DNS."}, {"id": "demo_readme_password_grant", "label": "Dex password grant token minting", "file_type": "rationale", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "oauth2.passwordConnector: local + enablePasswordDB lets an ID token be minted with a single curl, avoiding a browser redirect; --resolve keeps SNI, certificate and iss consistent with the Service DNS name."}, {"id": "demo_readme_run_sh", "label": "demo/run.sh orchestration", "file_type": "document", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent: builds the proxy image locally (chart default tag is not published for the fork), creates kind cluster, generates certs, deploys Dex, installs chart with --set-file authenticationConfig.content, applies RBAC, mints and verifies tokens."}, {"id": "demo_readme_tls_verification_note", "label": "insecure-skip-tls-verify in the demo", "file_type": "rationale", "source_file": "demo/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-to-proxy TLS is skipped because the chart generates a self-signed serving cert in a local demo; this does not weaken the OIDC path since Dex certs are verified against the inlined CA and token signatures against JWKS."}], "edges": [{"source": "demo_readme_multi_issuer_demo", "target": "demo_readme_dex_issuers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/README.md", "source_location": null, "weight": 1.0}, {"source": "demo_readme_multi_issuer_demo", "target": "docs_multi_issuer_authentication_configuration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/README.md", "source_location": null, "weight": 1.0}, {"source": "demo_readme_multi_issuer_demo", "target": "docs_architecture_readiness_semantics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/README.md", "source_location": null, "weight": 1.0}, {"source": "demo_readme_multi_issuer_demo", "target": "docs_architecture_impersonation", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "demo/README.md", "source_location": null, "weight": 1.0}, {"source": "demo_readme_run_sh", "target": "demo_manifests_proxy_values", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo/README.md", "source_location": null, "weight": 1.0}, {"source": "demo_readme_run_sh", "target": "demo_manifests_rbac", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "demo