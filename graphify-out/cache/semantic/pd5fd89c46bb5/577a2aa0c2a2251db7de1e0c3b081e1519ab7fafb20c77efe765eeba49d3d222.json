{"nodes": [{"id": "docs_caching", "label": "Caching and API-server protection", "file_type": "document", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passthrough TokenReview and inbound-impersonation SubjectAccessReview both scale with client behaviour; left unbounded they become API-server load. Caches follow the k8s.io/apiserver delegated auth precedent: 10s TTLs, definitive results only, 0 disables."}, {"id": "docs_caching_tokenreview_result_cache", "label": "TokenReview result cache", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split success/failure TTLs (--token-passthrough-cache-success-ttl / -failure-ttl, 10s each). Concurrent misses deliberately each run their own review on the caller's context so the request timeout and cancellation apply; duplicate reviews are the accepted cost. A cached success outlives token revocation up to the success TTL."}, {"id": "docs_caching_subjectaccessreview_decision_cache", "label": "SubjectAccessReview decision cache", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Split allow/deny TTLs tuned per failure mode: cached allow delays revocation, cached deny delays new grants. Key is the whole serialized SubjectAccessReviewSpec including requester UID so principals never share a decision; specs over 10000 bytes are never cached; hits produce identical error types so errors.Is and 403 semantics are unchanged."}, {"id": "docs_caching_impersonation_header_value_cap", "label": "Impersonation header value cap (--max-impersonation-header-values)", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each impersonation header value costs one SubjectAccessReview and the count is client-controlled, so a cap (default 64), not a cache, is the right tool. kube-apiserver tolerates unbounded counts because its check is in-process; here every value is a network call. Counted the way the handler consumes them so case variants cannot bypass it."}, {"id": "docs_caching_hmac_cache_keys", "label": "HMAC-SHA256 token cache keys", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tokens are never stored as keys; keys are HMAC-SHA256 with a per-instance random key over token and audiences, so keys cannot be precomputed and a memory dump does not yield tokens."}, {"id": "docs_caching_errors_never_cached", "label": "Errors never cached (fail-closed)", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unreachable API server or timed-out review fails only the request that saw it and is retried on the next; only definitive results are cached."}, {"id": "docs_caching_singleflight", "label": "Singleflight for concurrent SAR misses", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrent identical SAR misses share one review; if the shared call dies because another request was cancelled, waiters fall back to their own live check."}, {"id": "docs_caching_bounded_lru", "label": "Bounded LRU caches (8192 entries)", "file_type": "rationale", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both caches are bounded so client-influenced input can never grow proxy memory without bound."}, {"id": "docs_caching_http_431", "label": "HTTP 431 Request Header Fields Too Large rejection", "file_type": "concept", "source_file": "docs/caching.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_caching", "target": "docs_caching_tokenreview_result_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching", "target": "docs_caching_subjectaccessreview_decision_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching", "target": "docs_caching_impersonation_header_value_cap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching_tokenreview_result_cache", "target": "docs_configuration_token_passthrough", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching_hmac_cache_keys", "target": "docs_caching_tokenreview_result_cache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching_errors_never_cached", "target": "docs_caching_tokenreview_result_cache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_location": null, "weight": 1.0}, {"source": "docs_caching_errors_never_cached", "target": "docs_caching_subjectaccessreview_decision_cache", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/caching.md", "source_locatio