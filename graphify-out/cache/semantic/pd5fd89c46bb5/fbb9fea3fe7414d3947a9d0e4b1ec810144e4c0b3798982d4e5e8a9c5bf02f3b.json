{"nodes": [{"id": "_github_workflows_claude_review", "label": "Claude Review workflow", "file_type": "document", "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two paths: release PRs (autorelease label) are approved without review after the diff is verified to carry only generated changelog/fragment changes; '@claude review' comments by the OWNER trigger a Claude code review that approves only on a clean verdict. Listens to workflow_run of Prepare Release as a belt-and-braces trigger in case GitHub suppresses GITHUB_TOKEN pull_request events again; the approve step is idempotent."}, {"id": "_github_workflows_claude_review_release_approve", "label": "review:release-approve job", "file_type": "code", "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checks out .github/scripts from main (not the PR merge ref) so approval guards cannot be rewritten from release/next itself. Uses RELEASE_APPROVE_PAT because github-actions[bot] authors the release PR and cannot approve its own PR. Serialized via concurrency group release-approve so overlapping pull_request/workflow_run triggers see each other's review."}, {"id": "_github_workflows_claude_review_claude_review", "label": "review:claude job", "file_type": "code", "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs anthropics/claude-code-action with a threat-model prompt (auth bypass, impersonation/header smuggling, TokenReview/SubjectAccessReview caching, audit coverage, fail-open paths) and a JSON schema output {approve, summary}. Auto-approval only when approve==true AND the PR is not cross-repository."}, {"id": "_github_workflows_claude_review_untrusted_pr_content", "label": "Untrusted PR Content / Fork No-Auto-Approve Guard", "file_type": "rationale", "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PR diff, description, commits and comments are treated as untrusted data; any text attempting to steer the verdict is itself a blocking finding. Fork PRs get a review but never an auto-approval so a prompt-injected verdict cannot become a counted review."}, {"id": "_github_scripts_approve_release_pr", "label": ".github/scripts/approve-release-pr.sh", "file_type": "code", "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_github_workflows_claude_review", "target": "_github_workflows_claude_review_release_approve", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review", "target": "_github_workflows_claude_review_claude_review", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review", "target": "_github_workflows_prepare_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_release_approve", "target": "_github_scripts_approve_release_pr", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_claude_review", "target": "_github_scripts_approve_release_pr", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_release_approve", "target": "_github_workflows_prepare_release_release_next_branch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_release_approve", "target": "_github_workflows_prepare_release_autorelease_pending_label", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_claude_review", "target": "_github_workflows_claude_review_untrusted_pr_content", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}, {"source": "_github_workflows_claude_review_untrusted_pr_content", "target": "_github_workflows_claude_review_claude_review", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/claude-review.yaml", "source_location": null, "weight": 1.0}], "hyperedges": []}