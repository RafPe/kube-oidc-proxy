{"nodes": [{"id": "maintaining_maintaining_guide", "label": "Maintaining this fork", "file_type": "document", "source_file": "MAINTAINING.md", "source_location": "L1-L113", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "maintaining_independence_model", "label": "Fork independence model", "file_type": "rationale", "source_file": "MAINTAINING.md", "source_location": "L7-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fork does not depend on upstream for its security posture; its own Dependabot and weekly govulncheck workflow are the primary signal, so vulnerabilities are surfaced even without repository activity and nobody waits for an upstream release."}, {"id": "maintaining_upstream_tremolosecurity", "label": "Upstream TremoloSecurity/kube-oidc-proxy", "file_type": "concept", "source_file": "MAINTAINING.md", "source_location": "L21-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "maintaining_cherry_pick_pull_script", "label": "hack/cherry-pick-pull.sh", "file_type": "concept", "source_file": "MAINTAINING.md", "source_location": "L39-L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches the PR patch from a hardcoded jetstack URL; when cherry-picking from TremoloSecurity the URL must be adjusted."}, {"id": "maintaining_module_rename", "label": "Go module rename to github.com/rafpe/kube-oidc-proxy", "file_type": "concept", "source_file": "MAINTAINING.md", "source_location": "L65-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upstream code still imports github.com/jetstack/kube-oidc-proxy, so cherry-picked Go changes must have import paths rewritten before they build."}, {"id": "maintaining_originaluser_jetstack_extra_keys", "label": "originaluser.jetstack.io-* impersonation extra keys", "file_type": "concept", "source_file": "MAINTAINING.md", "source_location": "L88-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "These runtime extra keys are part of the impersonation API contract and must never be rewritten during the import-path reconciliation."}, {"id": "maintaining_kubernetes_versions_manifest", "label": "test/e2e/versions/kubernetes-versions.json (single source of truth)", "file_type": "concept", "source_file": "MAINTAINING.md", "source_location": "L92-L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the current minor plus two prior with node images from one kind release; CI matrix, kind CLI version and local make e2e default derive from it. go test ./test/e2e/versions/ fails until manifest and go.mod agree so compatibility is verified, not assumed."}], "edges": [{"source": "maintaining_maintaining_guide", "target": "maintaining_independence_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MAINTAINING.md", "source_location": "L7-L19", "weight": 1.0}, {"source": "maintaining_maintaining_guide", "target": "maintaining_upstream_tremolosecurity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MAINTAINING.md", "source_location": "L23-L24", "weight": 1.0}, {"source": "maintaining_maintaining_guide", "target": "maintaining_cherry_pick_pull_script", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MAINTAINING.md", "source_location": "L41", "weight": 1.0}, {"source": "maintaining_maintaining_guide", "target": "maintaining_module_rename", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MAINTAINING.md", "source_location": "L67-L68", "weight": 1.0}, {"source": "maintaining_maintaining_guide", "target": "maintaining_originaluser_jetstack_extra_keys", "relation": "references", "confidence": "EXTRACTED", "confide