ache, impersonation header cap", "nodes": ["changelog_max_impersonation_header_values", "changelog_subject_access_review_cache", "changelog_token_passthrough_cache", "chart_kube_oidc_proxy_values_maximpersonationheadervalues", "chart_kube_oidc_proxy_values_subjectaccessreview", "chart_kube_oidc_proxy_values_tokenpassthrough", "readme_subjectaccessreview", "readme_tokenreview"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CHANGELOG.md"}]}