{"nodes": [{"id": "changelog_changelog", "label": "CHANGELOG", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "L1-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_6_0", "label": "Release 1.6.0 (2026-09-01)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "L4-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_5_0", "label": "Release 1.5.0 (2026-08-28)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "L11-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_4_0", "label": "Release 1.4.0 (2026-08-20)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "L21-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_3_0", "label": "Release 1.3.0 (2026-08-19)", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "L25-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_max_impersonation_header_values", "label": "--max-impersonation-header-values cap (HTTP 431)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Impersonate-* header value fans out into a SubjectAccessReview, so an unbounded header set lets a client generate unbounded authorization load; capping at 64 by default and rejecting with 431 before any SAR bounds the per-request cost."}, {"id": "changelog_subject_access_review_cache", "label": "SubjectAccessReview decision cache (allow/deny TTLs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded in-memory cache with separate allow and deny TTLs (default 10s, 0 disables) shields the API server from repeated reviews; trade-off is that revoking or granting an RBAC impersonation permission can take up to the TTL to be enforced."}, {"id": "changelog_token_passthrough_cache", "label": "TokenReview result cache (success/failure TTLs)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches TokenReview results (default 10s, matching the kube-apiserver delegated-auth cache) so repeated passthrough tokens do not each hit the API server; a revoked token can keep passing for up to the success TTL and a newly valid token can be rejected for up to the failure TTL. API-server errors are never cached."}, {"id": "changelog_trusted_proxies", "label": "--trusted-proxies contract for audit sourceIPs", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forwarded headers from untrusted peers are stripped before auditing and before forwarding upstream so a client cannot spoof the audit trail via X-Forwarded-For; operators behind a load balancer must set --trusted-proxies to recover the real client IP."}, {"id": "changelog_unauthenticated_audit_events", "label": "Audit events for unauthenticated (401) requests", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The unauthorized audit chain now initialises the audit context so failed authentication attempts leave a ResponseStarted event rather than no trace."}, {"id": "changelog_uid_impersonation", "label": "End-to-end UID impersonation (Impersonate-Uid)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Impersonate-Uid is forwarded, the impersonation check reviews uids in the authentication.k8s.io group, and the chart grants impersonate on uids and the originaluser.jetstack.io-uid extra; deployments mapping a uid claim need the new RBAC."}, {"id": "changelog_token_passthrough_request_timeout", "label": "--token-passthrough-request-timeout", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_allow_reserved_groups", "label": "--allow-reserved-groups (replaces --allow-reserved-identity-claims)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permits named system:-prefixed groups instead of disabling the reserved-identity guard wholesale; reserved usernames can never be permitted. The replaced flag never appeared in a release."}, {"id": "changelog_reserved_identity_guard", "label": "Reserved system: identity guard", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An OIDC issuer must not be able to mint system:masters or a service-account username through the proxy's blanket impersonation rights. The check runs before the inbound-impersonation SubjectAccessReview and the 403 is audited against the presented identity; system:authenticated stays permitted because the proxy adds it itself."}, {"id": "changelog_long_running_audit", "label": "Audit streaming requests as long-running (ResponseStarted)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exec, attach, portforward, log and proxy are recorded when the response starts, so a long session is not missing from the audit log while it runs or lost entirely if the proxy dies; cost is higher audit volume for those verbs."}, {"id": "changelog_core_api_group_audit_classification", "label": "Core API group (/api) audit RequestInfo classification fix", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The audit server config named no legacy API prefix, so every /api request was recorded as a non-resource request with the HTTP method as verb and no objectRef; long-running and watch detection could never trigger. Events now carry the Kubernetes verb and objectRef."}, {"id": "changelog_readiness_gating_on_serving", "label": "Readiness reports not-ready until the proxy is serving", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously the readiness server started before the proxy handler chain, so a pod could join its Service while proxy-port requests could only queue."}, {"id": "changelog_token_validation_logging", "label": "OIDC token validation failures logged at -v=2 with remote address", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An error from the bearer-token authenticator always means a token was present and failed, so at -v=5 it was invisible at any verbosity operators actually run."}, {"id": "changelog_kubernetes_version_window", "label": "Supported Kubernetes window in PR e2e (1.37/1.36/1.35)", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": "L16-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PR e2e runs exercise the full supported window; the release path stays newest-only because the same code already passed the full window on its PR."}], "edges": [{"source": "changelog_changelog", "target": "changelog_v1_6_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L4", "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_v1_5_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L11", "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_v1_4_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L21", "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_v1_3_0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L25", "weight": 1.0}, {"source": "changelog_v1_6_0", "target": "changelog_max_impersonation_header_values", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L7", "weight": 1.0}, {"source": "changelog_v1_6_0", "target": "changelog_subject_access_review_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L8", "weight": 1.0}, {"source": "changelog_v1_6_0", "target": "changelog_token_passthrough_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L9", "weight": 1.0}, {"source": "changelog_v1_5_0", "target": "changelog_trusted_proxies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": "L13", "weight": 1.0}, {"source": "changelog_v1_5_0", "target": "changelog_unauthenticated_audit_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "C