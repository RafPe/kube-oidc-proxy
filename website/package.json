    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mermaid-js/layout-elk": "0.2.0",
    "astro": "7.3.6",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.12.2",
    "sharp": "0.35.5",
    "starlight-github-alerts": "0.5.0"
  }
