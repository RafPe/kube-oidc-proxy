    {
      "type": "state-timeline",
      "title": "Issuer initialized",
      "description": "Per-issuer state over time: 1 once that issuer's authenticator has fetched its JWKS on the selected pods. A band that drops to 0 is an issuer that never initialized on a restarted replica, which silently rejects every token from it. It reports initialization, not ongoing issuer availability. Each row is one issuer on one replica, labelled by issuer name; with more than one replica the same issuer appears once per pod, and hovering a band names it.",
      "datasource": {
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 70,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "not initialized"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "initialized"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
