    {
      "type": "stat",
      "title": "Reserved identity / header flood, last 1h",
      "description": "Attempts to impersonate a reserved system: identity, or to send more impersonation headers than the proxy accepts, in the last hour. These are not ordinary misconfiguration: a client does not send them by accident. Red above zero. Reads 0, not 'No data', when none has occurred.",
      "datasource": {
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(kube_oidc_proxy_access_decisions_total{namespace=\"$namespace\",pod=~\"$pod\",reason=~\"reserved_identity|too_many_impersonation_values\"}[1h])) or vector(0)",
          "legendFormat": "attempts",
          "range": true,
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
