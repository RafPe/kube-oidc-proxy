    {
      "type": "timeseries",
      "title": "Attempts/s by method and outcome",
      "description": "Authentication attempts per second before the identity and authorization checks that follow, by method and outcome. 'oidc' is a token the proxy verified itself; 'tokenreview' is the passthrough fallback asking the API server; 'none' is a request that carried no usable credential.",
      "datasource": {
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
