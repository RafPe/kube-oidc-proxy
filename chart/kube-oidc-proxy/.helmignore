# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# The dashboard linter's rule exclusions. The ConfigMap template globs
# dashboards/*.json, so this file is only ever read by
# hack/verify-chart-dashboards.sh and has no business in a released package.
dashboards/.lint
