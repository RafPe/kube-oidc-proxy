    {
      "dot": "emerald",
      "title": "Distinct identities",
      "items": [
        "Token from A \u2192 oidc-a:alice@example.com",
        "Token from B \u2192 oidc-b:bob@example.com",
        "Prefix per issuer keeps the two apart in RBAC"
      ]
    },
    {
      "dot": "rose",
      "title": "What stays put",
      "items": [
        "The API server's --oidc flags are never set",
